generator client {
  provider = "prisma-client-js"
}

model RecurringBudgetEntry {
  id          String    @id @default(uuid())
  householdId String
  categoryId  String?
  description String
  amountCents Int
  frequency   String
  nextDueOn   DateTime
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([householdId, nextDueOn])
}

model ChatReadState {
  id        String      @id @default(uuid())
  channelId String
  userId    String
  readAt    DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatChannel {
  id          String        @id @default(uuid())
  householdId String
  name        String
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  readStates  ChatReadState[]

  @@unique([householdId, name])
  @@index([householdId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  channelId String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model BudgetCategory {
  id          String                 @id @default(uuid())
  householdId String
  name        String
  createdAt   DateTime               @default(now())
  household   Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions BudgetTransaction[]
  recurringEntries RecurringBudgetEntry[]

  @@unique([householdId, name])
  @@index([householdId])
}

model BudgetTransaction {
  id          String          @id @default(uuid())
  householdId String
  categoryId  String?
  description String
  amountCents Int
  occurredOn  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([householdId, occurredOn])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password      String
  name          String
  createdTasks  Task[]   @relation("CreatedBy")
  assignedTasks Task[]   @relation("AssignedTo")
  events        Event[]
  memberships   Membership[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      ChatMessage[]
  chatReadStates ChatReadState[]
}

model Household {
  id          String       @id @default(uuid())
  name        String
  timezone    String       @default("UTC")
  memberships Membership[]
  categoryPreferences ItemCategoryPreference[]
  unitPreferences ItemUnitPreference[]
  barcodePreferences BarcodeProductPreference[]
  mealieIngredientLinks MealieIngredientLink[]
  chatChannels ChatChannel[]
  budgetCategories BudgetCategory[]
  budgetTransactions BudgetTransaction[]
  recurringBudgetEntries RecurringBudgetEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id          String    @id @default(uuid())
  userId      String
  householdId String
  role        String    @default("MEMBER")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
}

model Task {

  id              String    @id @default(uuid())
  householdId     String?

  title           String

  description     String?

  status          String    @default("TODO") // TODO, IN_PROGRESS, DONE

  type            String    @default("FAMILY") // FAMILY, PRIVATE, CHORE

  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH

  dueDate         DateTime?

  isRepeating     Boolean   @default(false)

  repeatFrequency String?   // DAILY, WEEKLY, MONTHLY, YEARLY

  steps           Step[]

  creatorId       String

  creator         User      @relation("CreatedBy", fields: [creatorId], references: [id])

  assigneeId      String?

  assignee        User?     @relation("AssignedTo", fields: [assigneeId], references: [id])

  createdAt       DateTime  @default(now())

  updatedAt       DateTime  @updatedAt

}



model Event {

  id              String    @id @default(uuid())
  householdId     String?

  title           String

  description     String?

  startTime       DateTime

  endTime         DateTime?

  location        String?

  isRepeating     Boolean   @default(false)

  repeatFrequency String?   // DAILY, WEEKLY, MONTHLY, YEARLY

  color           String    @default("#0ea5e9") // Default sky-500

  creatorId       String

  creator         User      @relation(fields: [creatorId], references: [id])

  createdAt       DateTime  @default(now())

  updatedAt       DateTime  @updatedAt

}

model Step {
  id        String  @id @default(uuid())
  content   String
  completed Boolean @default(false)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model GroceryItem {
  id        String   @id @default(uuid())
  householdId String?
  name      String
  quantity  String?
  details   String?
  category  String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemCategoryPreference {
  id          String    @id @default(uuid())
  householdId String
  itemName    String
  category    String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemName])
  @@index([householdId])
}

model ItemUnitPreference {
  id          String    @id @default(uuid())
  householdId String
  itemName    String
  unit        String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemName])
  @@index([householdId])
}

// Remembers what a scanned barcode corresponds to (name/category/unit) so a
// second scan of the same product - even if the original item was long since
// used up and removed from inventory - is instant and doesn't need another
// lookup against the external product database.
model BarcodeProductPreference {
  id          String    @id @default(uuid())
  householdId String
  barcode     String
  name        String
  category    String?
  unit        String?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, barcode])
  @@index([householdId])
}

// Manual override linking a Mealie recipe ingredient name to a specific
// inventory item name, for cases where auto-fuzzy-matching misses (e.g.
// "AP flour" in Mealie vs "flour" in inventory). Keyed per recipe so the
// same ingredient text can map differently across different recipes.
model MealieIngredientLink {
  id                 String    @id @default(uuid())
  householdId        String
  recipeSlug         String
  ingredientName     String
  inventoryItemName  String
  createdAt          DateTime  @default(now())
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, recipeSlug, ingredientName])
  @@index([householdId])
}

model FoodItem {
  id              String    @id @default(uuid())
  householdId     String?
  name            String
  quantity        Float     @default(1)
  unit            String?
  category        String    @default("General")
  location        String    @default("Pantry") // Pantry, Fridge, Freezer
  purchaseDate    DateTime  @default(now())
  trackExpiration Boolean   @default(true)
  expirationDate  DateTime?
  notes           String?
  barcode         String?
  // When set, the item is considered "low stock" whenever quantity drops to
  // or below this threshold (e.g. "always keep at least 2 boxes of pasta").
  parLevel        Float?
  lowStock        Boolean   @default(false)
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}